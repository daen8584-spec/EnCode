{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "target": "encoden",
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "**/.*", "**/node_modules/**", "users.json"],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(webp|svg)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  }
}
