{
  "hosting": {
    "target": "encoden",
    "public": ".",
    "ignore": [
      ".git/**",
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "users.json"
    ],
    "headers": [
      {
        "source": "**/*.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
  }
}
