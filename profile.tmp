<section class="view" id="view-profile">
<h1 class="view-title">Perfil</h1>
<p class="view-subtitle">Gerencie suas informações de conta.</p>
<div class="profile-header">
<div class="profile-avatar-wrapper">
<div class="profile-avatar">
<span class="profile-avatar-initials" id="profile-avatar-initials">?</span>
<img class="profile-avatar-img" id="profile-avatar-img" alt="" hidden>
</div>
<label class="profile-avatar-upload" for="profile-photo-input">Alterar foto</label>
<input type="file" id="profile-photo-input" accept="image/png,image/jpeg,image/webp" hidden>
</div>
<div class="profile-summary">
<h2 class="profile-name" id="profile-name">Usuário</h2>
<p class="profile-email" id="profile-email">email@exemplo.com</p>
<span class="profile-badge">Conta verificada</span>
</div>
</div>
<div class="profile-info-grid">
<article class="profile-info-card">
<span class="profile-info-label">Nome</span>
<span class="profile-info-value" id="profile-info-name">-</span>
</article>
<article class="profile-info-card">
<span class="profile-info-label">Email</span>
<span class="profile-info-value" id="profile-info-email">-</span>
</article>
<article class="profile-info-card">
<span class="profile-info-label">Membro desde</span>
<span class="profile-info-value" id="profile-info-created">-</span>
</article>
<article class="profile-info-card">
<span class="profile-info-label">Identificador</span>
<span class="profile-info-value profile-info-small" id="profile-info-uid">-</span>
</article>
</div>
<div class="profile-edit">
<h3 class="profile-edit-title">Editar nome</h3>
<form class="profile-edit-form" id="profile-edit-form" novalidate>
<label class="login-label" for="profile-edit-name">Nome</label>
<input class="login-input" id="profile-edit-name" name="name" type="text" minlength="2" autocomplete="name">
<button class="editor-run" type="submit" id="profile-edit-submit">Salvar</button>
</form>
</div>
</section>
